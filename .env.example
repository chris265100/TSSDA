# Supply these values through your shell or a dotenv-aware launcher.
# The CLI does not automatically load this file.
TSSDA_PROVIDER=deepseek
TSSDA_SCHEMA_ROOT=root.example
IOTDB_HOST=localhost
IOTDB_PORT=6667
IOTDB_USERNAME=
IOTDB_PASSWORD=

# DeepSeek-compatible generation endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternative Qwen-compatible generation endpoint (--provider qwen).
QWEN_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
